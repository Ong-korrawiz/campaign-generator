# Copy this file to .env. Only needed when generating teacher drafts.
OPENAI_API_KEY=
# Model used by the Zarn-to-brainstorm enrichment CLI.
OPENAI_MODEL=
# Local API: replace with the authenticated private inference service URL.
INFERENCE_URL=https://your-private-inference-service-url
# Cloud Run audience is usually the same service URL.
INFERENCE_AUDIENCE=https://your-private-inference-service-url
